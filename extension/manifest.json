{
  "manifest_version": 3,
  "name": "SignForest - LIBRAS para Busca",
  "version": "0.2.0",
  "description": "Reconhecimento local de sinais em LIBRAS por webcam.",
  "permissions": ["sidePanel", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Abrir SignForest"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}